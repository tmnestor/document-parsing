# Generated corpora do NOT land here any more -- config/generation_config.yml
# resolves output_dir and derived_dir outside the repository, and the export
# goes beside them. These entries are the belt to that braces: they catch a run
# whose config was overridden back to a local path, and cost nothing otherwise.
# Pinned by tests/test_data_location.py, which fails if the shipped default ever
# resolves inside the working tree again.
output/
derived/
parsing_*/
exports/
degraded/

# Transfer archives for the corpora above.
*.tgz
degraded_*.zip

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
.coverage
htmlcov/

# Editors and OS. AppleDouble sidecars in particular have broken transfers of
# this corpus before: a `._CASE001.png` beside a real image is counted by a
# naive glob and fails a completeness check.
.DS_Store
._*
.ipynb_checkpoints/
.vscode/
.idea/

# Local agent instructions, per-developer.
CLAUDE.md
